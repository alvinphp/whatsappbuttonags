<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="6.0" client="site" method="upgrade">
    <name>MOD_WHATSAPPBUTTONAGS</name>
    <creationDate>Oct 2025</creationDate>
    <author>Alvin Gil Saldaña</author>
    <authorEmail>alvin_gil@gotmail.com</authorEmail>
    <authorUrl>https://github.com/alvinphp</authorUrl>
    <copyright>Copyright © 2026 - All rights reserved.</copyright>
    <license>GNU General Public License v2.0</license>
    <version>1.0.2</version>
    <description>WhatsApp Button Module</description>

    <files>
        <filename module="mod_whatsappbuttonags">mod_whatsappbuttonags.php</filename>
        <filename>mod_whatsappbuttonags.xml</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
        <folder>assets</folder>
        <folder>language</folder>

    </files>

    <config>
        <!-- Configuración de parámetros del módulo -->
        <fields name="params">

            <!-- Opciones principales del módulo -->
            <fieldset name="basic" label="Configuración básica">

                <field
                    name="info_general"
                    type="note"
                    label="note"
                    description="This module needs to be enabled at DEBUG module position."
                />
                

                <field
                    name="phone"
                    type="text"
                    label="WhatsApp number"
                    description="Ingresa el número de WhatsApp (solo números)" 
                />
                <field
                    name="message_placeholder"
                    type="text"
                    label="Placeholder message"
                    default="Your message to send!"
                    description="Mensaje que se mostrara con referencia" 
                />
                <field
                    name="side"
                    type="list"
                    label="Button position"
                    default="right"
                    description="Selecciona en qué lado se mostrará el botón">
                    <option value="left">Left</option>
                    <option value="right">Right</option>
                </field>

            </fieldset>

        </fields>
    </config>
</extension>
